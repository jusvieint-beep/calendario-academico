# Copia este archivo como .env.local para trabajar en tu computador.
# En Vercel, crea las mismas variables en Settings → Environment Variables.

# Supabase → Project Settings → API (o Data API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Clave "publishable" (sb_publishable_...) o la clave "anon" (legacy). Es pública por diseño: RLS la limita.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Nombre que aparece en la cabecera y la pestaña del navegador
NEXT_PUBLIC_APP_NAME=Calendario Académico
# Opcional: texto pequeño bajo el nombre
NEXT_PUBLIC_APP_SUBTITLE=Clases y entregas · hora de Colombia

# Solo en Vercel: texto largo y aleatorio. Autoriza el cron diario que evita que Supabase pause el proyecto.
CRON_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
